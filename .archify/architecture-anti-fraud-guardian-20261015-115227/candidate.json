    {
      "dot": "amber",
      "title": "反诈闭环",
      "items": [
        "举报先经 review_keyword_rules 关键词规则筛查",
        "命中后生成 scam_reports 与 review_tasks 记录",
        "审核员在 review-center 页面通过 reviewContent 处理"
      ]
    },
    {
      "dot": "cyan",
      "title": "数据分层",
      "items": [
        "users、points_records 等私有集合仅本人可见",
        "public_profiles、articles 等公共集合用于展示与排行",
        "前端统一走云函数,不直接读写数据库"
      ]
    },
    {
      "dot": "emerald",
      "title": "管理与初始化",
      "items": [
        "getAdminTopicList、saveTopic 等管理云函数复用同一小程序前端",
        "initQuizQuestions、initProducts 等负责初始化数据"
      ]
    }
