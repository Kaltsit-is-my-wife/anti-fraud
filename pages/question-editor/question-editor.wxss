.manage-container{min-height:100vh;background:#f0f9ff;padding:20rpx;box-sizing:border-box;}
.panel{background:#fff;border-radius:24rpx;padding:24rpx;box-shadow:0 10rpx 24rpx rgba(2,132,199,0.10);margin-bottom:20rpx;}
.entry-panel{background:linear-gradient(135deg,#eff6ff,#f8fafc);}
.panel-title{font-size:32rpx;font-weight:700;color:#0f172a;margin-bottom:18rpx;}
.entry-title{font-size:30rpx;font-weight:700;color:#0f172a;line-height:1.5;}
.entry-hint{margin-top:10rpx;font-size:26rpx;line-height:1.7;color:#475569;}
.entry-actions{display:flex;gap:12rpx;margin-top:16rpx;flex-wrap:wrap;}
.input,.picker{height:76rpx;line-height:76rpx;background:#f8fafc;border-radius:16rpx;padding:0 20rpx;font-size:28rpx;color:#0f172a;margin-bottom:14rpx;box-sizing:border-box;}
.textarea{width:100%;min-height:140rpx;background:#f8fafc;border-radius:16rpx;padding:18rpx 20rpx;font-size:28rpx;line-height:1.6;color:#0f172a;margin-bottom:14rpx;box-sizing:border-box;}
.textarea.large{min-height:220rpx;}
.textarea.import-area{min-height:280rpx;font-family:"Consolas","Courier New",monospace;}
.switch-row{display:flex;align-items:center;justify-content:space-between;padding:10rpx 6rpx 18rpx;}
.switch-label{font-size:28rpx;color:#0f172a;}
.hint{font-size:24rpx;line-height:1.7;color:#64748b;}
.actions{display:flex;gap:14rpx;margin-top:14rpx;}
.btn{flex:1;background:#0ea5e9;color:#fff;border-radius:14rpx;font-size:30rpx;}
.btn.secondary{background:#e2e8f0;color:#0f172a;}
.list-card{padding:18rpx 0;border-top:1rpx solid #e2e8f0;}
.list-card:first-of-type{border-top:none;padding-top:0;}
.list-title{font-size:30rpx;font-weight:600;color:#0f172a;line-height:1.5;}
.list-meta{margin-top:8rpx;font-size:24rpx;color:#64748b;line-height:1.6;}
.list-tags{margin-top:8rpx;font-size:24rpx;color:#334155;line-height:1.6;}
.list-bank-text{margin-top:8rpx;font-size:24rpx;color:#1d4ed8;line-height:1.6;}
.list-exp{margin-top:8rpx;font-size:24rpx;color:#475569;line-height:1.7;}
.list-actions{display:flex;gap:12rpx;margin-top:12rpx;flex-wrap:wrap;}
.mini-btn{min-width:140rpx;height:64rpx;line-height:64rpx;border-radius:12rpx;font-size:24rpx;background:#0ea5e9;color:#fff;padding:0 20rpx;}
.mini-btn.secondary{background:#e2e8f0;color:#0f172a;}
.mini-btn.danger{background:#ef4444;color:#fff;}
.empty{padding:40rpx 0;text-align:center;color:#64748b;font-size:26rpx;}
