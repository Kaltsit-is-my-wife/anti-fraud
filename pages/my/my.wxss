/*
我的页面 - 用户个人资料模块

上游依赖：my.wxml结构文件
入口：页面加载时自动应用样式
主要功能：定义个人资料界面的视觉样式，包括头像、统计卡片、称号列表等组件
输出：渲染美观的用户个人资料界面样式

重要：每当所属的代码发生变化时，必须对相应的文档进行更新操作！
*/
/* pages/my/my.wxss */
.my-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f9ff 0%, #e0f2fe 100%);
  padding-bottom: 40rpx;
}

/* 用户卡片 */
.profile-card {
  margin: 40rpx;
  background: white;
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(14, 165, 233, 0.12);
}

.profile-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #e0f2fe;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  color: #0ea5e9;
  overflow: hidden;
  flex-shrink: 0;
}

.profile-avatar image {
  width: 100%;
  height: 100%;
}

.profile-info {
  flex: 0 1 auto;
  min-width: 0;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.nickname-edit {
  display: flex;
  flex-direction: column;
}

.profile-name-input {
  font-size: 36rpx;
  font-weight: 700;
  color: #1e293b;
  background: transparent;
  border-bottom: 2rpx solid #e2e8f0;
  padding-bottom: 8rpx;
  margin-bottom: 8rpx;
}

.uid-hint {
  font-size: 20rpx;
  color: #94a3b8;
}

.profile-name-container {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.edit-nickname-btn {
  font-size: 28rpx;
  color: #64748b;
  cursor: pointer;
}

.uid-text {
  font-size: 20rpx;
  color: #94a3b8;
}

.profile-sub {
  font-size: 24rpx;
  color: #64748b;
}

.profile-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  background: #f8fafc;
  padding: 24rpx 16rpx;
  border-radius: 24rpx;
}

.stat-item {
  text-align: center;
  position: relative;
}

.stat-item.clickable:active {
  opacity: 0.7;
}

.stat-item.disabled {
  opacity: 0.92;
}

.stat-item.clickable .stat-value {
  padding-bottom: 24rpx;
}

.stat-item .click-hint {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  font-size: 28rpx;
  color: #94a3b8;
  line-height: 1;
}

.stat-tag {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  font-size: 18rpx;
  line-height: 1;
  color: #b45309;
  background: #fef3c7;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #0ea5e9;
  margin-bottom: 8rpx;
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: #64748b;
  text-align: center;
}

.stat-label {
  font-size: 22rpx;
  color: #64748b;
}

/* 称号列表 */
.titles-card {
  margin: 0 40rpx 40rpx;
  background: white;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 12rpx 36rpx rgba(15, 23, 42, 0.08);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 12rpx;
}

.title-stats {
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 24rpx;
  color: #94a3b8;
  text-align: center;
  padding: 24rpx 0;
}

.title-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.title-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
}

.title-item.equipped {
  border-color: #0ea5e9;
  background: #e0f2fe;
}

.title-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.title-info {
  flex: 1;
  min-width: 0;
}

.title-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 6rpx;
}

.title-desc {
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.5;
  word-break: break-word;
}

.title-badge {
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  color: #64748b;
  text-transform: capitalize;
}

.title-badge.common {
  background: #e2e8f0;
  color: #64748b;
}

.title-badge.rare {
  background: #dbeafe;
  color: #2563eb;
}

.title-badge.epic {
  background: #fce7f3;
  color: #c026d3;
}

.title-badge.legendary {
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
  color: white;
}

/* 学习记录入口 */
.menu-card {
  margin: 0 40rpx 20rpx;
  background: white;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.menu-card.disabled {
  background: #f8fafc;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  gap: 24rpx;
}

.menu-icon {
  font-size: 56rpx;
  line-height: 1;
  flex-shrink: 0;
}

.menu-content {
  flex: 1;
  min-width: 0;
}

.menu-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.menu-desc {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}

.menu-card.disabled .menu-icon {
  opacity: 0.7;
}

.menu-card.disabled .menu-title {
  color: #475569;
}

.menu-status {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #b45309;
  background: #fef3c7;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  line-height: 1;
}

.menu-arrow {
  font-size: 48rpx;
  color: #94a3b8;
  line-height: 1;
  flex-shrink: 0;
}
