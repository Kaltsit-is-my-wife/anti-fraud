<view class="manage-container">
  <view class="panel">
    <view class="panel-title">{{editingId ? '编辑话题' : '新建话题'}}</view>
    <input class="input" placeholder="话题标题" value="{{form.title}}" bindinput="onInput" data-key="title" disabled="{{submitting || coverUploading || deletingTopicId}}" />
    <textarea class="textarea" placeholder="摘要" value="{{form.summary}}" bindinput="onInput" data-key="summary" disabled="{{submitting || coverUploading || deletingTopicId}}" />
    <textarea class="textarea large" placeholder="话题正文（纯文本）" value="{{form.contentText}}" bindinput="onInput" data-key="contentText" disabled="{{submitting || coverUploading || deletingTopicId}}" />

    <input class="input" placeholder="封面图 URL / cloud:// 文件 ID" value="{{form.coverImage}}" bindinput="onInput" data-key="coverImage" disabled="{{submitting || coverUploading || deletingTopicId}}" />
    <view class="cover-tools">
      <button class="mini-btn secondary" bindtap="chooseCoverImage" disabled="{{submitting || coverUploading || deletingTopicId}}">
        {{coverUploading ? '上传中...' : (form.coverImage ? '重新上传封面' : '上传封面')}}
      </button>
      <button wx:if="{{form.coverImage}}" class="mini-btn secondary" bindtap="clearCoverImage" disabled="{{submitting || coverUploading || deletingTopicId}}">清空封面</button>
    </view>
    <image wx:if="{{form.coverImage}}" class="cover-preview" src="{{form.coverImagePreview}}" mode="aspectFill"></image>

    <picker mode="selector" range="{{statusOptions}}" value="{{statusOptions.indexOf(form.status)}}" bindchange="onStatusChange" disabled="{{submitting || coverUploading || deletingTopicId}}">
      <view class="picker">状态：{{form.status}}</view>
    </picker>
    <input class="input" placeholder="排序值" value="{{form.sort}}" bindinput="onInput" data-key="sort" disabled="{{submitting || coverUploading || deletingTopicId}}" />
    <input class="input" placeholder="开始日期（如 2026-04-10）" value="{{form.startAt}}" bindinput="onInput" data-key="startAt" disabled="{{submitting || coverUploading || deletingTopicId}}" />
    <input class="input" placeholder="结束日期（如 2026-04-20）" value="{{form.endAt}}" bindinput="onInput" data-key="endAt" disabled="{{submitting || coverUploading || deletingTopicId}}" />
    <textarea class="textarea" placeholder="关联文章 ID，逗号分隔" value="{{form.relatedArticleIdsText}}" bindinput="onInput" data-key="relatedArticleIdsText" disabled="{{submitting || coverUploading || deletingTopicId}}" />
    <textarea class="textarea" placeholder="关联视频 ID，逗号分隔" value="{{form.relatedVideoIdsText}}" bindinput="onInput" data-key="relatedVideoIdsText" disabled="{{submitting || coverUploading || deletingTopicId}}" />

    <view class="actions">
      <button class="btn secondary" bindtap="resetForm" disabled="{{submitting || coverUploading || deletingTopicId}}">重置</button>
      <button class="btn" bindtap="saveTopic" disabled="{{submitting || coverUploading || deletingTopicId}}">{{submitting ? '保存中...' : '保存'}}</button>
    </view>
  </view>

  <view class="panel">
    <view class="panel-title">话题列表</view>
    <view wx:if="{{loading}}" class="empty">加载中...</view>
    <view wx:elif="{{topics.length === 0}}" class="empty">暂无话题</view>

    <view wx:for="{{topics}}" wx:key="_id" class="list-card">
      <view class="list-main" bindtap="editTopic" data-id="{{item._id}}">
        <image wx:if="{{item.coverImage}}" class="list-cover" src="{{item.coverImagePreview}}" mode="aspectFill"></image>
        <view class="list-body">
          <view class="list-title">{{item.title || '未命名话题'}}</view>
          <view class="list-meta">状态：{{item.status || 'draft'}} · 排序：{{item.sort || 0}}</view>
          <view wx:if="{{item.summary}}" class="list-desc">{{item.summary}}</view>
        </view>
      </view>
      <view class="list-actions">
        <button class="mini-btn secondary" bindtap="editTopic" data-id="{{item._id}}" disabled="{{submitting || coverUploading || deletingTopicId}}">编辑</button>
        <button class="mini-btn danger" catchtap="deleteTopic" data-id="{{item._id}}" disabled="{{submitting || coverUploading || deletingTopicId}}">
          {{deletingTopicId === item._id ? '删除中...' : '删除'}}
        </button>
      </view>
    </view>
  </view>
</view>
