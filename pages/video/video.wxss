.video-container {
  min-height: 100vh;
  background: #f0f9ff;
  padding: 20rpx;
  box-sizing: border-box;
}

.hero-card {
  padding: 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #0f172a 0%, #0ea5e9 100%);
  color: #fff;
  box-shadow: 0 16rpx 40rpx rgba(14, 165, 233, 0.18);
  margin-bottom: 22rpx;
}

.hero-badge {
  display: inline-flex;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 22rpx;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.3;
}

.hero-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.88);
}

.loading,
.empty {
  padding: 120rpx 20rpx;
  text-align: center;
  color: #64748b;
}

.empty-icon {
  font-size: 64rpx;
}

.empty-text {
  margin-top: 16rpx;
  font-size: 28rpx;
}

.video-card {
  position: relative;
  overflow: hidden;
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 10rpx 24rpx rgba(2, 132, 199, 0.10);
}

.cover {
  width: 100%;
  height: 260rpx;
  display: block;
  background: #dbeafe;
}

.cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e0f2fe 0%, #dbeafe 100%);
}

.cover-icon {
  font-size: 68rpx;
}

.duration {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.7);
  color: #fff;
  font-size: 22rpx;
}

.video-body {
  padding: 24rpx;
}

.video-title {
  font-size: 34rpx;
  line-height: 1.35;
  color: #0f172a;
  font-weight: 700;
}

.video-summary {
  margin-top: 12rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: #334155;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.video-meta {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #64748b;
}
