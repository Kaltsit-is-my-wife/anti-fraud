<view class="manage-container">
  <view class="panel">
    <view class="panel-title">{{editingId ? '编辑题库' : '新建题库'}}</view>
    <input class="input" placeholder="题库名称" value="{{form.name}}" bindinput="onInput" data-key="name" />
    <textarea class="textarea" placeholder="题库简介" value="{{form.summary}}" bindinput="onInput" data-key="summary" />
    <input class="input" placeholder="封面图 URL / cloud:// 文件ID" value="{{form.coverImage}}" bindinput="onInput" data-key="coverImage" />
    <picker mode="selector" range="{{statusOptions}}" value="{{statusOptions.indexOf(form.status)}}" bindchange="onStatusChange">
      <view class="picker">状态：{{form.status}}</view>
    </picker>
    <input class="input" placeholder="排序值" value="{{form.sort}}" bindinput="onInput" data-key="sort" />
    <input class="input" placeholder="默认抽题数量" value="{{form.defaultQuestionCount}}" bindinput="onInput" data-key="defaultQuestionCount" />
    <view class="actions">
      <button class="btn secondary" bindtap="resetForm">重置</button>
      <button class="btn" bindtap="saveBank">保存</button>
    </view>
  </view>

  <view class="panel">
    <view class="panel-title">题库列表</view>
    <view wx:if="{{loading}}" class="empty">加载中...</view>
    <view wx:elif="{{banks.length === 0}}" class="empty">暂无题库</view>
    <view wx:for="{{banks}}" wx:key="_id" class="list-card" bindtap="editBank" data-id="{{item._id}}">
      <view class="list-title">{{item.name || '未命名题库'}}</view>
      <view class="list-meta">状态：{{item.status || 'draft'}} ｜ 默认抽题：{{item.defaultQuestionCount || 10}}</view>
      <view wx:if="{{item.summary}}" class="list-desc">{{item.summary}}</view>
    </view>
  </view>
</view>
