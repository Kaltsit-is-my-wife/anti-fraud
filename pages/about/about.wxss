/* pages/about/about.wxss */
.about-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f9ff 0%, #e0f2fe 100%);
  padding: 32rpx 0 40rpx;
}

.hero-card {
  position: relative;
  overflow: hidden;
  margin: 0 40rpx 28rpx;
  padding: 44rpx 36rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #0f172a 0%, #0369a1 55%, #0891b2 100%);
  color: #fff;
  box-shadow: 0 18rpx 50rpx rgba(3, 105, 161, 0.18);
}

.hero-card::after {
  content: '';
  position: absolute;
  right: -90rpx;
  top: -80rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.hero-badge {
  position: relative;
  z-index: 1;
  display: inline-flex;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.app-logo {
  position: relative;
  z-index: 1;
  font-size: 104rpx;
  margin-top: 26rpx;
}

.app-name {
  position: relative;
  z-index: 1;
  font-size: 48rpx;
  font-weight: 700;
  margin-top: 16rpx;
}

.app-desc {
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.92);
}

.app-mission {
  position: relative;
  z-index: 1;
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: rgba(255, 255, 255, 0.78);
}

.facts-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin: 0 40rpx 40rpx;
}

.fact-card {
  background: rgba(255, 255, 255, 0.82);
  border-radius: 24rpx;
  padding: 24rpx 20rpx;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.06);
}

.fact-label {
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.5;
}

.fact-value {
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #0f172a;
  line-height: 1.6;
}

.features-section,
.notes-section,
.team-section,
.notice-section,
.contact-section {
  margin: 0 40rpx 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 24rpx;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.feature-card {
  background: white;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.feature-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.feature-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}

.notes-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.note-card {
  background: white;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.note-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
}

.note-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.8;
}

.team-card {
  background: white;
  border-radius: 24rpx;
  padding: 30rpx 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.team-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.5;
}

.team-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.8;
}

.notice-card {
  background: white;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.notice-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.notice-item + .notice-item {
  margin-top: 18rpx;
}

.notice-dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: #f97316;
  flex-shrink: 0;
}

.notice-text {
  flex: 1;
  font-size: 28rpx;
  color: #334155;
  line-height: 1.8;
}

.contact-list {
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
}

.contact-item {
  padding: 32rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-label {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 10rpx;
}

.contact-value {
  font-size: 28rpx;
  color: #0ea5e9;
  font-weight: 500;
}

.contact-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.copyright {
  text-align: center;
  padding: 40rpx;
  font-size: 24rpx;
  color: #94a3b8;
  line-height: 2;
}
