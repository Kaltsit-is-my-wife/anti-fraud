<!--
社区页面 - 社区模块 (v3)

上游依赖：community.js页面逻辑，community.wxss样式文件
入口：Tab页 /pages/community/community
主要功能：展示热点话题列表、跳转话题详情
输出：渲染话题列表

重要：每当所属的代码发生变化时，必须对相应的文档进行更新操作！
-->
<!--pages/community/community.wxml-->
<view class="community-container">
  <scroll-view scroll-y class="list">
    <view class="hero-card">
      <view class="hero-badge">社区介绍</view>
      <view class="hero-title">聚焦校园反诈议题，围绕真实案例展开讨论</view>
      <view class="hero-desc">这里集中呈现校园高发骗局、社会热点案例和实用避坑经验。每个话题都会先梳理背景与重点，再邀请大家交流见闻、提出问题和补充建议。</view>
      <view class="hero-tags">
        <text class="hero-tag">校园高发</text>
        <text class="hero-tag">案例复盘</text>
        <text class="hero-tag">经验交流</text>
      </view>
      <view class="hero-note">当前已发布 {{topics.length}} 个专题，可在话题详情中查看背景说明并参与评论交流。</view>
      <view class="hero-actions">
        <button class="hero-btn secondary" bindtap="refresh" loading="{{loading}}">刷新列表</button>
        <button class="hero-btn" bindtap="showCommunityNotice">参与说明</button>
      </view>
    </view>

    <view wx:if="{{topics.length === 0 && !loading && !loadFailed}}" class="empty">
      <text class="empty-icon">📌</text>
      <view class="empty-text">当前还没有已发布的话题</view>
      <view class="empty-subtext">平台发布专题后，这里会展示对应的讨论入口和背景说明。</view>
    </view>

    <view wx:if="{{loadFailed && !loading}}" class="empty">
      <text class="empty-icon">⚠️</text>
      <view class="empty-text">话题列表加载失败</view>
      <view class="empty-subtext">请稍后重试</view>
    </view>

    <view wx:for="{{topics}}" wx:key="_id" class="topic-card" bindtap="goDetail" data-id="{{item._id}}">
      <view class="cover-wrap">
        <image wx:if="{{item.coverImage}}" class="cover" src="{{item.coverImage}}" mode="aspectFill"></image>
        <view wx:else class="cover cover-placeholder">
          <text class="cover-emoji">🛡️</text>
        </view>
        <view class="cover-gradient"></view>
        <view class="cover-status status-{{item.topicStage || 'published'}}">{{item.topicStageLabel || '进行中'}}</view>
      </view>

      <view class="topic-body">
        <view class="topic-title">{{item.title}}</view>
        <view class="topic-summary" wx:if="{{item.summary}}">{{item.summary}}</view>

        <view class="topic-footer">
          <view class="period">
            <text class="period-icon">🗓</text>
            <text>{{item.periodText}}</text>
          </view>
          <view class="detail-btn">查看详情 ›</view>
        </view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="loading">加载中...</view>
  </scroll-view>
</view>
