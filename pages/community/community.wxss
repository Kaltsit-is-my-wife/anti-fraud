.community-container{
  min-height:100vh;
  background:#f0f9ff;
  box-sizing:border-box;
}
.list{
  height:100vh;
  padding:20rpx;
  box-sizing:border-box;
}
.hero-card{
  position:relative;
  overflow:hidden;
  padding:30rpx;
  border-radius:28rpx;
  background:linear-gradient(135deg,#0f172a 0%,#0369a1 52%,#0891b2 100%);
  color:#fff;
  box-shadow:0 16rpx 40rpx rgba(14,165,233,0.18);
  margin-bottom:22rpx;
}
.hero-card::after{
  content:'';
  position:absolute;
  right:-90rpx;
  top:-90rpx;
  width:240rpx;
  height:240rpx;
  border-radius:50%;
  background:rgba(255,255,255,0.10);
}
.hero-badge{
  position:relative;
  z-index:1;
  display:inline-flex;
  padding:8rpx 18rpx;
  border-radius:999rpx;
  background:rgba(255,255,255,0.16);
  font-size:22rpx;
  letter-spacing:2rpx;
}
.hero-title{
  position:relative;
  z-index:1;
  margin-top:18rpx;
  font-size:38rpx;
  font-weight:700;
  line-height:1.3;
}
.hero-desc{
  position:relative;
  z-index:1;
  margin-top:14rpx;
  font-size:26rpx;
  line-height:1.7;
  color:rgba(255,255,255,0.88);
}
.hero-tags{
  position:relative;
  z-index:1;
  display:flex;
  flex-wrap:wrap;
  gap:12rpx;
  margin-top:20rpx;
}
.hero-tag{
  padding:8rpx 16rpx;
  border-radius:999rpx;
  background:rgba(255,255,255,0.14);
  font-size:22rpx;
  color:rgba(255,255,255,0.92);
}
.hero-note{
  position:relative;
  z-index:1;
  margin-top:18rpx;
  font-size:24rpx;
  line-height:1.7;
  color:rgba(255,255,255,0.78);
}
.hero-actions{
  position:relative;
  z-index:1;
  display:flex;
  gap:14rpx;
  margin-top:20rpx;
}
.hero-btn{
  flex:1;
  height:76rpx;
  line-height:44rpx;
  border-radius:999rpx;
  background:#fff;
  color:#0f172a;
  font-size:28rpx;
  font-weight:600;
}
.hero-btn.secondary{
  background:rgba(255,255,255,0.16);
  color:#fff;
  border:1rpx solid rgba(255,255,255,0.22);
}
.topic-card{
  background:#fff;
  border-radius:24rpx;
  margin-bottom:18rpx;
  box-shadow:0 4rpx 20rpx rgba(2,132,199,0.10), 0 1rpx 4rpx rgba(0,0,0,0.06);
  box-sizing:border-box;
  width:100%;
  overflow:hidden;
}
.cover-wrap{
  position:relative;
  width:100%;
  height:260rpx;
}
.cover{
  width:100%;
  height:260rpx;
  display:block;
  background:#dbeafe;
}
.cover-placeholder{
  width:100%;
  height:260rpx;
  display:flex;
  align-items:center;
  justify-content:center;
  background:linear-gradient(135deg,#e0f2fe 0%,#dbeafe 100%);
}
.cover-emoji{font-size:72rpx;}
.cover-gradient{
  position:absolute;
  bottom:0;
  left:0;
  right:0;
  height:100rpx;
  background:linear-gradient(to top, rgba(0,0,0,0.28) 0%, transparent 100%);
}
.cover-status{
  position:absolute;
  top:20rpx;
  left:20rpx;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  height:44rpx;
  padding:0 18rpx;
  border-radius:999rpx;
  font-size:22rpx;
  font-weight:600;
  backdrop-filter:blur(8px);
}
.status-ongoing{background:rgba(220,252,231,0.92);color:#15803d;}
.status-ended{background:rgba(226,232,240,0.92);color:#475569;}
.status-upcoming{background:rgba(254,243,199,0.92);color:#b45309;}
.status-published{background:rgba(219,234,254,0.92);color:#1d4ed8;}
.topic-body{padding:24rpx;}
.topic-title{
  font-size:34rpx;
  line-height:1.4;
  color:#0f172a;
  font-weight:700;
}
.topic-summary{
  margin-top:12rpx;
  font-size:27rpx;
  line-height:1.7;
  color:#475569;
  display:-webkit-box;
  -webkit-line-clamp:2;
  -webkit-box-orient:vertical;
  overflow:hidden;
}
.topic-footer{
  margin-top:20rpx;
  padding-top:18rpx;
  border-top:1rpx solid #f1f5f9;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16rpx;
}
.period{
  display:flex;
  align-items:center;
  gap:8rpx;
  font-size:24rpx;
  color:#94a3b8;
}
.period-icon{font-size:24rpx;}
.detail-btn{
  font-size:26rpx;
  color:#0ea5e9;
  font-weight:600;
  background:#f0f9ff;
  padding:10rpx 22rpx;
  border-radius:999rpx;
  border:1rpx solid #bae6fd;
}
.empty{padding:120rpx 20rpx;text-align:center;color:#64748b;}
.empty-icon{font-size:64rpx;}
.empty-text{margin-top:16rpx;font-size:28rpx;}
.empty-subtext{margin-top:10rpx;font-size:24rpx;color:#94a3b8;}
.loading{text-align:center;color:#94a3b8;font-size:26rpx;padding:20rpx 0 40rpx;}
