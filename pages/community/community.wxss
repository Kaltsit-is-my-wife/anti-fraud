.community-container{
  min-height:100vh;
  background:#f0f9ff;
  box-sizing:border-box;
}
.list{
  height:100vh;
  padding:20rpx;
  box-sizing:border-box;
}
.hero-card{
  padding:30rpx;
  border-radius:28rpx;
  background:linear-gradient(135deg,#0f172a 0%,#0ea5e9 100%);
  color:#fff;
  box-shadow:0 16rpx 40rpx rgba(14,165,233,0.18);
  margin-bottom:22rpx;
}
.hero-badge{
  display:inline-flex;
  padding:8rpx 18rpx;
  border-radius:999rpx;
  background:rgba(255,255,255,0.16);
  font-size:22rpx;
  letter-spacing:2rpx;
}
.hero-title{
  margin-top:18rpx;
  font-size:38rpx;
  font-weight:700;
  line-height:1.3;
}
.hero-desc{
  margin-top:14rpx;
  font-size:26rpx;
  line-height:1.7;
  color:rgba(255,255,255,0.88);
}
.hero-actions{
  display:flex;
  gap:14rpx;
  margin-top:20rpx;
}
.hero-btn{
  flex:1;
  height:76rpx;
  line-height:76rpx;
  border-radius:999rpx;
  background:#fff;
  color:#0f172a;
  font-size:28rpx;
  font-weight:600;
}
.hero-btn.secondary{
  background:rgba(255,255,255,0.16);
  color:#fff;
  border:1rpx solid rgba(255,255,255,0.22);
}
.topic-card{
  background:#fff;
  border-radius:24rpx;
  margin-bottom:18rpx;
  box-shadow:0 10rpx 24rpx rgba(2,132,199,0.10);
  box-sizing:border-box;
  width:100%;
  overflow:hidden;
}
.cover{
  width:100%;
  height:260rpx;
  display:block;
  background:#dbeafe;
}
.cover-placeholder{
  display:flex;
  align-items:center;
  justify-content:center;
  background:linear-gradient(135deg,#e0f2fe 0%,#dbeafe 100%);
}
.cover-emoji{font-size:72rpx;}
.topic-body{padding:24rpx;}
.topic-top{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16rpx;
}
.topic-status{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-width:112rpx;
  height:44rpx;
  padding:0 18rpx;
  border-radius:999rpx;
  font-size:22rpx;
  font-weight:600;
}
.status-ongoing{background:#dcfce7;color:#15803d;}
.status-ended{background:#e2e8f0;color:#475569;}
.status-upcoming{background:#fef3c7;color:#b45309;}
.status-published{background:#dbeafe;color:#1d4ed8;}
.topic-date{font-size:24rpx;color:#64748b;}
.topic-title{
  margin-top:18rpx;
  font-size:34rpx;
  line-height:1.35;
  color:#0f172a;
  font-weight:700;
}
.topic-summary{
  margin-top:12rpx;
  font-size:27rpx;
  line-height:1.7;
  color:#334155;
  display:-webkit-box;
  -webkit-line-clamp:3;
  -webkit-box-orient:vertical;
  overflow:hidden;
}
.topic-footer{
  margin-top:20rpx;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16rpx;
}
.period{font-size:24rpx;color:#64748b;}
.detail-link{font-size:26rpx;color:#0ea5e9;font-weight:600;}
.empty{padding:120rpx 20rpx;text-align:center;color:#64748b;}
.empty-icon{font-size:64rpx;}
.empty-text{margin-top:16rpx;font-size:28rpx;}
.empty-subtext{margin-top:10rpx;font-size:24rpx;color:#94a3b8;}
.loading{text-align:center;color:#94a3b8;font-size:26rpx;padding:20rpx 0 40rpx;}

