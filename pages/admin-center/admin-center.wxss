.admin-container {
  min-height: 100vh;
  background: #f0f9ff;
  padding: 20rpx;
  box-sizing: border-box;
}

.hero-card {
  padding: 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #0f172a 0%, #0ea5e9 100%);
  color: #fff;
  box-shadow: 0 16rpx 40rpx rgba(14, 165, 233, 0.18);
  margin-bottom: 22rpx;
}

.hero-badge {
  display: inline-flex;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 22rpx;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.3;
}

.hero-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.88);
}

.entry-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 24rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 10rpx 24rpx rgba(2, 132, 199, 0.10);
  margin-bottom: 16rpx;
}

.entry-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  background: #dbeafe;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  flex-shrink: 0;
}

.entry-body {
  flex: 1;
  min-width: 0;
}

.entry-title {
  font-size: 32rpx;
  line-height: 1.4;
  color: #0f172a;
  font-weight: 700;
}

.entry-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #64748b;
}

.entry-arrow {
  font-size: 44rpx;
  color: #cbd5e1;
}
