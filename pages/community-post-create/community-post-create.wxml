<!--
发帖页面 - 社区模块 (v3)

上游依赖：community-post-create.js页面逻辑
入口：/pages/community-post-create/community-post-create
主要功能：展示自由发帖入口已关闭提示
输出：引导返回社区页

重要：每当所属的代码发生变化时，必须对相应的文档进行更新操作！
-->
<view class="container">
  <view class="page-header">
    <view class="header-title">社区升级提示</view>
    <view class="header-right"></view>
  </view>

  <view class="card">
    <view class="notice-badge">官方话题讨论</view>
    <view class="notice-title">普通用户公开发帖入口已关闭</view>
    <view class="notice-desc">{{notice}}</view>
    <button class="submit" bindtap="goCommunity">返回社区</button>
  </view>
</view>

