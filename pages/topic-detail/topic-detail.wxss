.topic-detail-container{
  min-height:100vh;
  background:#f0f9ff;
}
.loading{
  padding:120rpx 0;
  text-align:center;
  font-size:28rpx;
  color:#64748b;
}
.content{
  padding-bottom:140rpx;
}
.cover{
  width:100%;
  height:360rpx;
  display:block;
  background:#dbeafe;
}
.cover-placeholder{
  display:flex;
  align-items:center;
  justify-content:center;
  background:linear-gradient(135deg,#dbeafe 0%,#e0f2fe 100%);
}
.cover-emoji{
  font-size:88rpx;
}
.header-card,
.section-card{
  margin:20rpx;
  padding:24rpx;
  border-radius:24rpx;
  background:#fff;
  box-shadow:0 10rpx 24rpx rgba(2,132,199,0.10);
}
.badge{
  display:inline-flex;
  padding:8rpx 18rpx;
  border-radius:999rpx;
  background:#dbeafe;
  color:#1d4ed8;
  font-size:22rpx;
  font-weight:600;
}
.title{
  margin-top:16rpx;
  font-size:40rpx;
  line-height:1.35;
  color:#0f172a;
  font-weight:700;
}
.meta{
  display:flex;
  flex-wrap:wrap;
  gap:12rpx 20rpx;
  margin-top:14rpx;
  font-size:24rpx;
  color:#64748b;
}
.summary{
  margin-top:18rpx;
  font-size:28rpx;
  line-height:1.8;
  color:#334155;
}
.section-title{
  font-size:32rpx;
  font-weight:700;
  color:#0f172a;
}
.paragraph{
  margin-top:18rpx;
  font-size:28rpx;
  line-height:1.8;
  color:#334155;
  white-space:pre-wrap;
}
.image-block{
  margin-top:20rpx;
}
.detail-image{
  width:100%;
  border-radius:20rpx;
  background:#e2e8f0;
}
.image-caption{
  margin-top:10rpx;
  font-size:24rpx;
  color:#64748b;
  text-align:center;
}
.link-card{
  margin-top:18rpx;
  padding:18rpx 20rpx;
  border-radius:18rpx;
}
.article-link{
  background:#eff6ff;
}
.video-link{
  background:#ecfeff;
}
.link-label{
  font-size:26rpx;
  font-weight:600;
  color:#0f172a;
}
.link-text{
  margin-top:8rpx;
  font-size:24rpx;
  line-height:1.6;
  color:#475569;
}
.related-card{
  display:flex;
  align-items:center;
  gap:18rpx;
  margin-top:18rpx;
  padding:16rpx;
  border-radius:18rpx;
  background:#f8fafc;
}
.related-cover{
  width:160rpx;
  height:110rpx;
  border-radius:16rpx;
  background:#dbeafe;
  flex-shrink:0;
}
.related-body{
  flex:1;
  min-width:0;
}
.related-title{
  font-size:28rpx;
  line-height:1.5;
  color:#0f172a;
  font-weight:600;
}
.related-summary{
  margin-top:8rpx;
  font-size:24rpx;
  line-height:1.6;
  color:#64748b;
  display:-webkit-box;
  -webkit-line-clamp:2;
  -webkit-box-orient:vertical;
  overflow:hidden;
}
.empty-text{
  margin-top:16rpx;
  font-size:26rpx;
  line-height:1.7;
  color:#475569;
}
.comment-item{
  display:flex;
  margin-top:18rpx;
  padding-top:18rpx;
  border-top:1rpx solid #e2e8f0;
}
.comment-item.reply{
  margin-left:40rpx;
}
.comment-avatar{
  width:64rpx;
  height:64rpx;
  border-radius:32rpx;
  background:#dbeafe;
  flex-shrink:0;
}
.comment-avatar.placeholder{
  display:flex;
  align-items:center;
  justify-content:center;
}
.comment-body{
  flex:1;
  margin-left:14rpx;
}
.comment-top{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12rpx;
}
.comment-name{
  font-size:28rpx;
  font-weight:600;
  color:#0f172a;
}
.comment-time{
  font-size:22rpx;
  color:#94a3b8;
}
.comment-content{
  margin-top:8rpx;
  font-size:26rpx;
  line-height:1.7;
  color:#334155;
  white-space:pre-wrap;
}
.reply-to{
  color:#0ea5e9;
}
.comment-actions{
  margin-top:8rpx;
}
.reply-btn{
  font-size:24rpx;
  color:#0ea5e9;
}
.comment-notice{
  margin-top:18rpx;
  font-size:24rpx;
  line-height:1.6;
  color:#64748b;
}
.input-bar{
  position:fixed;
  left:0;
  right:0;
  bottom:0;
  display:flex;
  align-items:center;
  gap:12rpx;
  padding:14rpx 16rpx calc(14rpx + env(safe-area-inset-bottom));
  background:#fff;
  border-top:1rpx solid #e2e8f0;
}
.comment-input{
  flex:1;
  height:72rpx;
  padding:0 24rpx;
  border-radius:999rpx;
  background:#f1f5f9;
  font-size:28rpx;
  box-sizing:border-box;
}
.comment-send{
  height:72rpx;
  line-height:72rpx;
  padding:0 28rpx;
  border-radius:999rpx;
  background:#0ea5e9;
  color:#fff;
  font-size:28rpx;
}
