<view class="review-container">
  <view class="tab-bar">
    <view wx:for="{{tabs}}" wx:key="key" class="tab-item {{currentStatus === item.key ? 'active' : ''}}" bindtap="switchTab" data-status="{{item.key}}">
      {{item.label}}
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">审核任务加载中...</view>

  <view wx:elif="{{tasks.length === 0}}" class="empty">
    <view class="empty-icon">📭</view>
    <view class="empty-text">当前没有对应状态的审核任务</view>
  </view>

  <view wx:for="{{tasks}}" wx:key="_id" class="task-card">
    <view class="task-header">
      <view class="task-type">{{item.targetType}}</view>
      <view class="task-time">{{item.createdAtText}}</view>
    </view>
    <view class="task-content">{{item.contentText}}</view>
    <view wx:if="{{item.keywordText}}" class="keyword-list">
      命中关键词：{{item.keywordText}}
    </view>
    <view class="task-status">状态：{{item.reviewStatus}}</view>

    <view wx:if="{{currentStatus === 'pending_review'}}" class="task-actions">
      <button class="action-btn approve" bindtap="reviewTask" data-id="{{item._id}}" data-action="approve">通过</button>
      <button class="action-btn reject" bindtap="reviewTask" data-id="{{item._id}}" data-action="reject">驳回</button>
      <button class="action-btn hide" bindtap="reviewTask" data-id="{{item._id}}" data-action="hide">隐藏</button>
    </view>
  </view>
</view>
