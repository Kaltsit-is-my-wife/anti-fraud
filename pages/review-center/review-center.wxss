.review-container {
  min-height: 100vh;
  background: #f8fafc;
  padding: 20rpx;
  box-sizing: border-box;
}

.tab-bar {
  display: flex;
  gap: 12rpx;
  background: #fff;
  padding: 10rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #64748b;
}

.tab-item.active {
  background: linear-gradient(135deg, #0ea5e9 0%, #06b6d4 100%);
  color: #fff;
  font-weight: 600;
}

.loading,
.empty {
  padding: 120rpx 20rpx;
  text-align: center;
  color: #64748b;
}

.empty-icon {
  font-size: 64rpx;
}

.empty-text {
  margin-top: 16rpx;
  font-size: 28rpx;
}

.task-card {
  margin-top: 18rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 22rpx;
  box-shadow: 0 10rpx 24rpx rgba(2, 132, 199, 0.10);
}

.task-header {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  font-size: 24rpx;
  color: #64748b;
}

.task-type {
  color: #0ea5e9;
  font-weight: 600;
}

.task-content {
  margin-top: 14rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #0f172a;
  white-space: pre-wrap;
}

.keyword-list,
.task-status {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #64748b;
}

.task-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #64748b;
}

.remark-box {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
}

.remark-input {
  width: 100%;
  min-height: 112rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #0f172a;
}

.remark-counter {
  margin-top: 10rpx;
  text-align: right;
  font-size: 22rpx;
  color: #94a3b8;
}

.task-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.action-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
}

.action-btn.approve {
  background: #16a34a;
  color: #fff;
}

.action-btn.reject {
  background: #ef4444;
  color: #fff;
}

.action-btn.hide {
  background: #475569;
  color: #fff;
}

.task-warning {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #fff7ed;
  color: #c2410c;
  font-size: 24rpx;
  line-height: 1.6;
}
