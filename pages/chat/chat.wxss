/* pages/chat/chat.wxss */
.chat-container {
  height: 100vh;
  background: linear-gradient(180deg, #eff7fd 0%, #f7fbfe 44%, #f2f7fb 100%);
  overflow: hidden;
}

.chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.chat-header {
  flex-shrink: 0;
  padding: 24rpx;
  background: transparent;
}

.chat-header-card {
  padding: 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #0f77b7 0%, #2a9ed6 100%);
  box-shadow: 0 16rpx 40rpx rgba(14, 116, 144, 0.2);
}

.chat-header-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.chat-header-main {
  flex: 1;
  min-width: 0;
}

.chat-kicker {
  display: block;
  font-size: 18rpx;
  line-height: 1;
  letter-spacing: 4rpx;
  color: rgba(255, 255, 255, 0.74);
  margin-bottom: 14rpx;
}

.chat-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.2;
}

.chat-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.84);
}

.chat-tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.chat-tag {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 1;
}

.clear-btn {
  width: 108rpx;
  height: 56rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 56rpx;
  box-sizing: border-box;
}

.clear-btn::after {
  border: none;
}

.clear-btn:active {
  opacity: 0.7;
}

.chat-messages {
  flex: 1;
  min-height: 0;
  height: 0;
  padding: 8rpx 24rpx 0;
  box-sizing: border-box;
}

.empty-panel {
  padding-bottom: 24rpx;
}

.intro-card {
  padding: 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid #e4edf4;
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.06);
}

.privacy-banner {
  padding: 4rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #dff8ef 0%, #f0fbf7 100%);
}

.privacy-text {
  display: block;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #0f766e;
  font-size: 24rpx;
  line-height: 1.6;
}

.intro-title {
  display: block;
  margin-top: 22rpx;
  font-size: 32rpx;
  line-height: 1.4;
  font-weight: 700;
  color: #10243c;
}

.intro-description {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #526273;
}

.quick-prompt-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 22rpx;
}

.quick-prompt {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #f7fbff 0%, #f0f7fd 100%);
  border: 1rpx solid #d7e8f8;
}

.quick-prompt:active {
  opacity: 0.75;
}

.quick-prompt-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  background: #0f77b7;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.quick-prompt-copy {
  flex: 1;
  min-width: 0;
}

.quick-prompt-title {
  display: block;
  font-size: 25rpx;
  font-weight: 700;
  color: #17324d;
  line-height: 1.3;
}

.quick-prompt-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #6d8094;
}

.intro-tip {
  display: block;
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #7a8a9a;
}

.conversation-banner {
  padding: 0 0 12rpx;
}

.conversation-banner-text {
  display: block;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #e4edf4;
  color: #5b7085;
  font-size: 24rpx;
  line-height: 1.6;
}

.message-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
  animation: messageEnter 0.28s ease;
}

.message-row.user {
  flex-direction: row-reverse;
}

@keyframes messageEnter {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.message-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
}

.message-avatar.is-bot {
  background: #0f77b7;
  color: #ffffff;
}

.message-avatar.is-user {
  background: #e8f1f8;
  color: #17324d;
}

.message-stack {
  max-width: calc(100% - 88rpx);
  display: flex;
  flex-direction: column;
}

.message-row.user .message-stack {
  align-items: flex-end;
}

.message-role {
  display: block;
  margin-bottom: 8rpx;
  padding: 0 6rpx;
  font-size: 22rpx;
  color: #6b7d90;
  line-height: 1;
}

.message-bubble {
  max-width: 100%;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.75;
  word-break: break-word;
}

.message-bubble text {
  white-space: pre-wrap;
  display: block;
}

.message-bubble.bot {
  background: #ffffff;
  border: 1rpx solid #e4edf4;
  color: #17324d;
  border-top-left-radius: 8rpx;
}

.message-bubble.user {
  background: #0f77b7;
  color: #ffffff;
  border-top-right-radius: 8rpx;
}

.message-image {
  width: 100%;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  display: block;
}

.loading-bubble {
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.62;
  }
}

.chat-input-area {
  flex-shrink: 0;
  padding: 18rpx 24rpx calc(-55rpx + env(safe-area-inset-bottom));
  background: transparent;
}

.composer-main {
  display: flex;
  align-items: center;
  gap: 14rpx;
  width: 100%;
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(218, 227, 238, 0.96);
  box-shadow: 0 12rpx 28rpx rgba(15, 23, 42, 0.08);
  box-sizing: border-box;
}

.icon-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 1rpx solid #d7e1ea;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
}

.icon-btn.is-disabled,
.composer-center.is-disabled {
  opacity: 0.46;
}

.composer-center {
  flex: 1 1 0;
  min-width: 0;
  height: 76rpx;
  border-radius: 999rpx;
  background: #f3f5f7;
  border: 1rpx solid #edf1f5;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.composer-center.is-text {
  padding: 0 28rpx;
  justify-content: flex-start;
}

.composer-center.is-voice:active,
.icon-btn:active {
  opacity: 0.76;
}

.voice-placeholder {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
  letter-spacing: 0.5rpx;
}

.chat-input {
  flex: 1;
  display: block;
  width: 100%;
  height: 100%;
  padding: 0;
  background: transparent;
  box-sizing: border-box;
}

.compact-input {
  display: block;
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0;
  font-size: 28rpx;
  color: #111827;
  background: transparent;
}

.camera-icon {
  position: relative;
  width: 34rpx;
  height: 26rpx;
}

.camera-top {
  position: absolute;
  left: 8rpx;
  top: 0;
  width: 14rpx;
  height: 8rpx;
  border: 4rpx solid #111827;
  border-bottom: none;
  border-radius: 6rpx 6rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}

.camera-body {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 20rpx;
  border: 4rpx solid #111827;
  border-radius: 8rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.camera-lens {
  position: absolute;
  left: 50%;
  top: 8rpx;
  width: 10rpx;
  height: 10rpx;
  margin-left: -5rpx;
  border: 4rpx solid #111827;
  border-radius: 50%;
  background: #ffffff;
  box-sizing: border-box;
}

.grid-icon {
  width: 30rpx;
  height: 30rpx;
  display: flex;
  flex-wrap: wrap;
  padding: 1rpx;
  box-sizing: border-box;
}

.grid-dot {
  width: 6rpx;
  height: 6rpx;
  margin: 2rpx;
  border-radius: 50%;
  background: #111827;
}

.action-toggle-btn.is-send {
  background: #111827;
  border-color: #111827;
}

.plus-icon {
  position: relative;
  width: 24rpx;
  height: 24rpx;
}

.plus-icon-horizontal,
.plus-icon-vertical {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 24rpx;
  height: 4rpx;
  margin-left: -12rpx;
  margin-top: -2rpx;
  border-radius: 999rpx;
  background: #111827;
}

.plus-icon-vertical {
  transform: rotate(90deg);
}

.send-icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
}

.send-icon-line {
  position: absolute;
  left: 2rpx;
  top: 12rpx;
  width: 16rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.send-icon-head {
  position: absolute;
  right: 2rpx;
  top: 8rpx;
  width: 10rpx;
  height: 10rpx;
  border-top: 4rpx solid #ffffff;
  border-right: 4rpx solid #ffffff;
  transform: rotate(45deg);
  box-sizing: border-box;
}
