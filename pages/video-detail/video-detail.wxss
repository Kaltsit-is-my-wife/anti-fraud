.video-detail-container {
  min-height: 100vh;
  background: #f0f9ff;
}

.loading {
  padding: 120rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #64748b;
}

.content {
  padding-bottom: 40rpx;
}

.player {
  width: 100%;
  height: 420rpx;
  background: #000;
}

.player-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
}

.detail-card {
  margin: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 10rpx 24rpx rgba(2, 132, 199, 0.10);
}

.badge {
  display: inline-flex;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #dbeafe;
  color: #1d4ed8;
  font-size: 22rpx;
  font-weight: 600;
}

.title {
  margin-top: 16rpx;
  font-size: 40rpx;
  line-height: 1.35;
  color: #0f172a;
  font-weight: 700;
}

.meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 20rpx;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #64748b;
}

.summary {
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #334155;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.related-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 16rpx;
  border-radius: 18rpx;
  background: #f8fafc;
}

.related-cover {
  width: 160rpx;
  height: 110rpx;
  border-radius: 16rpx;
  background: #dbeafe;
  flex-shrink: 0;
}

.related-body {
  flex: 1;
  min-width: 0;
}

.related-title {
  font-size: 28rpx;
  line-height: 1.5;
  color: #0f172a;
  font-weight: 600;
}

.related-summary {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #64748b;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
