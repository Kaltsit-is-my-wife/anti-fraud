<!--pages/index/index.wxml-->
<view class="index-container">
  <!-- 固定顶部区域 -->
  <view class="fixed-header">
    <!-- 顶部区域 -->
    <view class="top-bar">
      <view class="subtitle">校园反诈学习平台</view>
    </view>

    <!-- 分类标签（横向滚动） -->
    <scroll-view class="category-tabs" scroll-x enable-flex>
      <view
        wx:for="{{categories}}"
        wx:key="index"
        class="tab-item {{selectedCategory === item ? 'active' : ''}}"
        bindtap="selectCategory"
        data-category="{{item}}"
      >
        {{item}}
      </view>
    </scroll-view>
  </view>

  <!-- 占位区域 -->
  <view class="header-placeholder"></view>

  <!-- 轮播图 -->
  <view class="banner-slider" wx:if="{{banners.length > 0}}">
    <swiper
      class="slider-container"
      indicator-dots
      indicator-color="rgba(255,255,255,0.5)"
      indicator-active-color="#ffffff"
      autoplay
      interval="3000"
      circular
    >
      <swiper-item wx:for="{{banners}}" wx:key="id" bindtap="onBannerTap" data-link="{{item.link}}">
        <view class="slide-content" style="background: {{item.bgColor || 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)'}};">
          <!-- 如果有云存储图片，显示图片 -->
          <image wx:if="{{item.image}}" class="slide-bg" src="{{item.image}}" mode="aspectFill"></image>

          <!-- 半透明遮罩（有图片时显示，让文字更清晰） -->
          <view wx:if="{{item.image}}" class="slide-overlay"></view>

          <!-- 文字内容 -->
          <view class="slide-text">
            <view wx:if="{{item.icon}}" class="slide-icon">{{item.icon}}</view>
            <view class="slide-title">{{item.title}}</view>
            <view wx:if="{{item.desc}}" class="slide-desc">{{item.desc}}</view>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <!-- 云函数失败时明确提示使用了本地降级轮播 -->
    <view wx:if="{{bannerMode === 'fallback'}}" class="banner-hint">
      云端轮播暂不可用，当前展示默认轮播内容
    </view>
  </view>

  <!-- 云端成功但没有启用中的轮播 -->
  <view class="banner-slider" wx:elif="{{bannerMode === 'empty'}}">
    <view class="banner-empty">
      <view class="banner-empty-icon">🖼️</view>
      <view class="banner-empty-title">暂无轮播内容</view>
      <view class="banner-empty-text">运营暂未配置首页轮播，下方资讯可正常浏览。</view>
    </view>
  </view>

  <view class="entry-grid">
    <view class="entry-card" bindtap="goTopicCommunity">
      <view class="entry-icon">📌</view>
      <view class="entry-title">热点话题</view>
      <view class="entry-desc">围绕校园高发与热点案例展开讨论</view>
    </view>
    <view class="entry-card" bindtap="goVideoList">
      <view class="entry-icon">🎬</view>
      <view class="entry-title">视频学习</view>
      <view class="entry-desc">通过短视频快速理解常见骗局</view>
    </view>
    <view class="entry-card" bindtap="goQuizHome">
      <view class="entry-icon">🧠</view>
      <view class="entry-title">题库答题</view>
      <view class="entry-desc">按主题学习并练习识骗要点</view>
    </view>
  </view>

  <!-- 新闻列表 -->
  <view class="content-area">
    <view wx:if="{{isDemoData}}" class="demo-notice">
      <text class="demo-notice-title">当前为演示数据</text>
      <text class="demo-notice-text">云端资讯暂时不可用，以下内容仅供功能演示。</text>
    </view>
    <view class="section-title">🔥 反诈资讯</view>

    <view
      wx:for="{{articles}}"
      wx:key="id"
      class="news-card"
      bindtap="viewArticle"
      data-id="{{item.id}}"
    >
      <view class="tag tag-{{item.tagType}}">{{item.tag}}</view>
      <view class="news-title">{{item.title}}</view>
      <view class="news-meta">
        <text class="meta-time">{{item.time}}</text>
        <text class="meta-view">👁️ {{item.viewsText}}</text>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{hasMore}}" bindtap="loadMoreArticles">
      <text wx:if="{{isLoading}}">正在加载...</text>
      <text wx:else>点击加载更多</text>
    </view>
    <view class="load-more" wx:elif="{{articles.length > 0}}">
      <text>—— 我是有底线的 ——</text>
    </view>
    <view class="empty-state" wx:else>
      <view class="empty-icon">📭</view>
      <view class="empty-text">暂无相关资讯</view>
      <view class="empty-tip">试试切换其他分类吧</view>
    </view>
  </view>
</view>
